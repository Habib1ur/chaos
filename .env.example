# =============================================================================
# CHAOS — Environment Variables Example
# Copy to .env (backend/root) and apps/web/.env.local (frontend)
# NEVER commit real .env files or expose server secrets with NEXT_PUBLIC_
# =============================================================================

# --- Frontend (apps/web/.env.local) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# --- Backend (apps/server & root Prisma) ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Supabase PostgreSQL Connection String (Transaction/Session Pooler or Direct)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chaos?schema=public

# Secret used to sign guest & user session tokens (min 32 chars in production)
SESSION_SECRET=replace-with-a-long-random-secret-at-least-32-chars

# Optional Redis URL (Upstash) for horizontal scaling
REDIS_URL=
